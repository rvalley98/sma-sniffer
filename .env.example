# MQTT broker configuration
MQTT_HOST=192.168.178.149
MQTT_PORT=1883
MQTT_USER=shelly
MQTT_PASS=shelly

# Optional: map SMA devices to roles by their serial number.
# Leave empty on first run, then check the [DEVICE] lines in the log to find
# the serial of each device and fill them in.
# If METER_SERIAL is empty, the grid meter is auto-detected by its SUSY id.
METER_SERIAL=1900255994
PV_SERIAL=
BATTERY_SERIAL=

# Active polling of the inverters (Sunny Tripower / Sunny Island) via the
# SMA Speedwire "Data2+" protocol. The inverters do NOT broadcast their power
# like the energy meter does, so they have to be queried directly by IP.
# Leave the IP empty to disable polling for that device.
PV_IP=
BATTERY_IP=
# Login password of the inverters (SMA default user-group password is 0000).
INVERTER_PASSWORD=0000
# User group used for the login: "user" or "installer".
INVERTER_USER_GROUP=user
# How often (seconds) to poll the inverters.
POLL_INTERVAL=10

# Log every published value (several lines per second). Set to 0 to turn off.
LOG_VALUES=1

# Debug: set to 1 to dump all decoded OBIS channels (once per device) to the log.
DEBUG_OBIS=
