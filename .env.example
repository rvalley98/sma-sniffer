# MQTT broker configuration
MQTT_HOST=192.168.178.149
MQTT_PORT=1883
MQTT_USER=shelly
MQTT_PASS=shelly

# Optional: map SMA devices to roles by their serial number.
# Leave empty on first run, then check the [DEVICE] lines in the log to find
# the serial of each device and fill them in.
# If METER_SERIAL is empty, the grid meter is auto-detected by its SUSY id.
METER_SERIAL=
PV_SERIAL=
BATTERY_SERIAL=
